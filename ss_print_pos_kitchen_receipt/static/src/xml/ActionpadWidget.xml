<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">

    <!-- Render primary Order button & manual KOT print button side-by-side -->
    <t t-name="ss_print_pos_kitchen_receipt.ActionpadWidget" t-inherit="point_of_sale.ActionpadWidget" t-inherit-mode="extension">
        <xpath expr="//div[1]" position="inside">
            <div class="d-flex gap-1 w-100 mt-1">
                <t t-if="this.hasChangesToOrder">
                    <button class="button btn btn-primary btn-lg flex-grow-1 py-3 order-kitchen-button"
                            style="background-color: #28a745 !important; border-color: #28a745 !important; color: #ffffff !important; font-weight: bold; font-size: 17px; cursor: pointer; min-height: 52px; display: flex; align-items: center; justify-content: center;"
                            t-on-click="() => (this.onClickOrderButton ? this.onClickOrderButton() : (this.pos &amp;&amp; this.pos.sendOrderAndReturnToTables &amp;&amp; this.pos.sendOrderAndReturnToTables()))">
                        <i class="fa fa-paper-plane me-1"/> Order
                        <t t-if="this.changeSummary">
                            <span class="ms-1 badge bg-dark text-white" style="font-size: 12px; font-weight: normal; padding: 3px 6px; border-radius: 4px;">
                                <t t-esc="this.changeSummary"/>
                            </span>
                        </t>
                    </button>
                </t>
                <button class="button btn btn-info btn-lg py-3 manual-kot-button"
                        t-att-class="this.hasChangesToOrder ? 'w-auto px-3' : 'w-100'"
                        style="background-color: #17a2b8 !important; border-color: #17a2b8 !important; color: #ffffff !important; font-weight: bold; font-size: 17px; cursor: pointer; min-height: 52px; display: flex; align-items: center; justify-content: center;"
                        t-on-click="() => (this.onClickManualKotButton ? this.onClickManualKotButton() : (this.pos &amp;&amp; this.pos.forceBrowserPrintDialog &amp;&amp; this.pos.forceBrowserPrintDialog()))">
                    <i class="fa fa-print me-1"/> KOT
                </button>
            </div>
        </xpath>
    </t>

</templates>








