<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">

    <!-- Add Order and KOT buttons directly to ActionpadWidget main POS screen -->
    <t t-name="ss_print_pos_kitchen_receipt.ActionpadWidget" t-inherit="point_of_sale.ActionpadWidget" t-inherit-mode="extension">
        <xpath expr="//div[1]" position="inside">
            <div class="d-flex w-100 gap-1 mt-1">
                <button class="button btn btn-primary btn-lg flex-fill py-3 order-kitchen-button"
                        style="background-color: #28a745 !important; border-color: #28a745 !important; color: #ffffff !important; font-weight: bold; font-size: 16px; cursor: pointer;"
                        t-on-click="onClickOrderButton">
                    <i class="fa fa-paper-plane me-1"/> Order
                </button>
                <button class="button btn btn-secondary btn-lg flex-fill py-3 kot-button"
                        style="font-weight: bold; font-size: 16px; cursor: pointer;"
                        t-on-click="printKitchenReceipt">
                    <i class="fa fa-cutlery me-1"/> KOT
                </button>
            </div>
        </xpath>
    </t>

</templates>


